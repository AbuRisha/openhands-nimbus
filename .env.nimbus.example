# ------------------------------------------------------------------------
# Nimbus fork — ACA / dev environment template
# ------------------------------------------------------------------------
# Copy to `.env.nimbus` (gitignored) for local dev, OR feed these directly
# into `az containerapp create --env-vars ...` for the openhands-nimbus ACA.
#
# The four LLM_* vars are the ONLY thing required to route every agent turn
# through https://api.nimbusapi.net/v1. Everything else has safe defaults.
# ------------------------------------------------------------------------

# ---- LiteLLM defaults (read by the OpenHands app-server on startup) ----
LLM_MODEL=anthropic/claude-sonnet-5
LLM_BASE_URL=https://api.nimbusapi.net/v1
# In ACA this is injected as a secret reference; DO NOT commit a real key.
LLM_API_KEY=${NIMBUS_API_KEY}

# ---- Catalog gating ----------------------------------------------------
# `true` (default) restricts the UI model-picker to the 15 curated SS-native
# chat models in openhands/app_server/config_api/nimbus_llm_model_service.py.
# Set to `false` only in local dev when you want to browse LiteLLM's full
# catalogue. NEVER set to `false` in a customer-facing deploy.
NIMBUS_CATALOG_MODE=true

# ---- BYOK visibility --------------------------------------------------
# Upstream default is `true`, which surfaces the "Advanced: bring your own
# key" collapsible on the LLM settings page. That is the intended Nimbus
# customer experience — the user only clicks it if they want to point the
# app at a non-Nimbus endpoint with their own credentials.
OH_ALLOW_USER_LLM_CONFIGURATION=true

# ---- Nimbus SSO --------------------------------------------------------
# Shared secret used by getnimbus.net for cross-app session hand-off.
NIMBUS_SSO_SHARED_SECRET=${NIMBUS_SSO_SHARED_SECRET}

# ---- Execution stop switch --------------------------------------------
# Halts the money-spending paths (conversation start, message send, sandbox
# start/resume, queued auto-run) with a 503, while history, settings and
# billing keep serving. Leave it unset in normal operation: it defaults OPEN,
# because per-customer key delegation already works
# (settings/nimbus_customer_key.py) and a default-closed gate only 503s a
# healthy deployment behind a variable somebody has to remember.
# Set to false during an incident to stop agent runs without downing the app.
# NIMBUS_CUSTOMER_METERING_READY=false
#
# Hosted auth itself is NIMBUS_REQUIRE_AUTH (default on) — see
# nimbus_sso/nimbus_auth_gate.py. There is deliberately no second variable for
# it here.

# ---- App-server essentials --------------------------------------------
# Runtime backend. `local` runs the agent in-process (single-container ACA
# deploy compatible). Set to `remote` for hosted agent-server, or `docker`
# only when a host docker socket is available (not in ACA).
RUNTIME=local
FILE_STORE=memory
